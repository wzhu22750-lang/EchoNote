<?xml version="1.0" encoding="utf-8"?>
<!-- EchoNote keeps everything in app-private storage. Cloud backup and
     device-to-device transfer are disabled so call recordings never leave the
     device without an explicit user export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
